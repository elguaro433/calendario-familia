rules_version = '2';

// Reglas de Firestore del proyecto familia-diaz-gonzalez (copia de lo publicado en la consola).
// Si las cambias en la consola, actualiza también este archivo.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Datos de la familia: app de finanzas y calendario (desde el 25/10/2026) ──
    // Todo vive en familias/<id>/appdata/<documento>. El <id> (64 caracteres) sale de la
    // clave familiar: sin la clave no se puede leer, listar ni escribir nada.
    match /familias/{fam}/appdata/{docId} {
      allow read, write: if fam.size() == 64;
    }

    // ── TEMPORAL mientras se copian los datos: la colección vieja, aún abierta ──
    match /appdata/{docId} {
      allow read, write: if true;
    }

    // Todo lo demás, bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
